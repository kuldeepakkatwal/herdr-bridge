[Unit]
Description=Herdr Screen (phone remote desktop, X11)
After=graphical-session.target

[Service]
Environment=DISPLAY=:0
# What the Cinnamon session itself uses (checked in /proc/<cinnamon>/environ on the Acer, 2026-11-01)
Environment=XAUTHORITY=%h/.Xauthority
ExecStart=/usr/bin/python3 %h/.herdr-remote/herdr_screen.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
